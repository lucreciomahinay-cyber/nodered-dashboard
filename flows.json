[{"id":"rp_tab","type":"tab","label":"Rice Paddy IoT Controller - FINAL","disabled":false,"info":"ESP32-WROOM-32D + HiveMQ Cloud + Node-RED Dashboard 2.0"},{"id":"rp_control_template","type":"ui-template","z":"rp_tab","group":"rp_ui_group","page":"","ui":"","name":"Phase Day and Manual Controls","order":1,"width":"12","height":"9","head":"","format":"<template>\n  <div style=\"padding:12px\">\n    <h2>Rice Paddy Irrigation Controller</h2>\n    <p>Select AUTO for sensor-based operation. Select MANUAL to operate individual outputs.</p>\n\n    <label><b>Operating mode</b></label>\n    <select v-model=\"mode\" style=\"display:block;width:100%;padding:10px;margin:6px 0 14px\">\n      <option value=\"AUTO\">AUTO — Automatic control</option>\n      <option value=\"MANUAL\">MANUAL — Individual output controls</option>\n    </select>\n\n    <label><b>Growth phase</b></label>\n    <select v-model.number=\"phase\" @change=\"day=Math.min(day, duration)\" style=\"display:block;width:100%;padding:10px;margin:6px 0 14px\">\n      <option :value=\"1\">Phase 1 — Establishment (20 days)</option>\n      <option :value=\"2\">Phase 2 — Vegetative growth (70 days)</option>\n      <option :value=\"3\">Phase 3 — Final growth and drainage (30 days)</option>\n    </select>\n\n    <label><b>Day within phase (1–{{ duration }})</b></label>\n    <input type=\"number\" v-model.number=\"day\" min=\"1\" :max=\"duration\"\n      style=\"display:block;width:100%;box-sizing:border-box;padding:10px;margin:6px 0 14px\"/>\n\n    <button @click=\"applySettings\" style=\"padding:12px 18px;background:#287a46;color:#fff;border:0;border-radius:6px;cursor:pointer\">\n      Apply Phase, Day and Mode\n    </button>\n\n    <hr style=\"margin:20px 0\"/>\n    <div v-if=\"mode === 'MANUAL'\">\n      <h3>Manual Actuator Controls</h3>\n      <p style=\"font-size:13px;color:#666\">Each button sends the complete output state. Only available while MANUAL is selected.</p>\n\n      <div v-for=\"(v,i) in valves\" :key=\"'valve'+i\"\n        style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #ddd\">\n        <b>Zone {{ i+1 }} irrigation valve</b>\n        <button @click=\"setValve(i,!valves[i])\"\n          :style=\"{padding:'10px 16px',border:0,borderRadius:'6px',color:'#fff',background:valves[i]?'#b42318':'#287a46',cursor:'pointer'}\">\n          {{ valves[i] ? 'TURN OFF' : 'TURN ON' }}\n        </button>\n      </div>\n\n      <div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #ddd\">\n        <b>Drainage relay</b>\n        <button @click=\"setDrainRelay(!drainRelay)\"\n          :style=\"{padding:'10px 16px',border:0,borderRadius:'6px',color:'#fff',background:drainRelay?'#b42318':'#287a46',cursor:'pointer'}\">\n          {{ drainRelay ? 'TURN OFF' : 'TURN ON' }}\n        </button>\n      </div>\n\n      <div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #ddd\">\n        <b>Drainage servo</b>\n        <button @click=\"setDrainServo(!drainServoOpen)\"\n          :style=\"{padding:'10px 16px',border:0,borderRadius:'6px',color:'#fff',background:drainServoOpen?'#b42318':'#287a46',cursor:'pointer'}\">\n          {{ drainServoOpen ? 'CLOSE SERVO' : 'OPEN SERVO' }}\n        </button>\n      </div>\n\n      <button @click=\"allOff\" style=\"margin-top:14px;padding:12px 18px;background:#b42318;color:#fff;border:0;border-radius:6px;cursor:pointer\">\n        ALL OUTPUTS OFF\n      </button>\n    </div>\n    <div v-else>\n      <h3>Manual Controls Disabled</h3>\n      <p>Switch to MANUAL and press Apply Phase, Day and Mode before operating individual outputs.</p>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      mode: 'AUTO',\n      phase: 1,\n      day: 1,\n      valves: [false, false, false],\n      drainRelay: false,\n      drainServoOpen: false\n    }\n  },\n  computed: {\n    duration() {\n      return ({1:20, 2:70, 3:30})[this.phase] || 20\n    }\n  },\n  methods: {\n    sendCommand(manualControl) {\n      this.send({\n        topic: 'ricepaddy/control',\n        payload: {\n          mode: this.mode,\n          phase: Number(this.phase),\n          day: Number(this.day),\n          apply: false,\n          manualControl: manualControl,\n          valves: this.valves.slice(),\n          drainRelay: this.drainRelay,\n          drainServoOpen: this.drainServoOpen\n        }\n      })\n    },\n    applySettings() {\n      const limits = {1:20, 2:70, 3:30}\n      const p = Number(this.phase)\n      const d = Number(this.day)\n      if (!limits[p] || !Number.isInteger(d) || d < 1 || d > limits[p]) {\n        alert('Invalid day for the selected phase.')\n        return\n      }\n\n      if (this.mode === 'MANUAL') {\n        // Enter MANUAL with outputs explicitly OFF for safe handover.\n        this.valves = [false, false, false]\n        this.drainRelay = false\n        this.drainServoOpen = false\n        this.send({\n          topic: 'ricepaddy/control',\n          payload: {\n            mode: 'MANUAL', phase: p, day: d, apply: true,\n            manualControl: true, valves: [false,false,false],\n            drainRelay: false, drainServoOpen: false\n          }\n        })\n      } else {\n        this.send({\n          topic: 'ricepaddy/control',\n          payload: {mode:'AUTO', phase:p, day:d, apply:true}\n        })\n      }\n    },\n    setValve(i, state) {\n      if (this.mode !== 'MANUAL') return\n      this.valves[i] = state\n      this.sendCommand(true)\n    },\n    setDrainRelay(state) {\n      if (this.mode !== 'MANUAL') return\n      this.drainRelay = state\n      this.sendCommand(true)\n    },\n    setDrainServo(state) {\n      if (this.mode !== 'MANUAL') return\n      this.drainServoOpen = state\n      this.sendCommand(true)\n    },\n    allOff() {\n      if (this.mode !== 'MANUAL') return\n      this.valves = [false, false, false]\n      this.drainRelay = false\n      this.drainServoOpen = false\n      this.sendCommand(true)\n    }\n  }\n}\n</script>","storeOutMessages":false,"resendOnRefresh":false,"templateScope":"local","className":"","x":300,"y":140,"wires":[["rp_control_json"]]},{"id":"rp_control_json","type":"function","z":"rp_tab","name":"Serialize MQTT command","func":"if (typeof msg.payload !== 'string') {\n    msg.payload = JSON.stringify(msg.payload);\n}\nmsg.topic = 'ricepaddy/control';\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":580,"y":140,"wires":[["rp_control_mqtt"]]},{"id":"rp_control_mqtt","type":"mqtt out","z":"rp_tab","name":"Send commands to ESP32","topic":"","qos":"1","retain":"false","respTopic":"","contentType":"application/json","userProps":"","correl":"","expiry":"","broker":"rp_broker","x":830,"y":140,"wires":[]},{"id":"rp_telemetry_mqtt","type":"mqtt in","z":"rp_tab","name":"ESP32 Live Telemetry","topic":"ricepaddy/telemetry","qos":"1","datatype":"auto","broker":"rp_broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":270,"y":280,"wires":[["rp_parse_telemetry"]]},{"id":"rp_parse_telemetry","type":"json","z":"rp_tab","name":"Parse telemetry JSON","property":"payload","action":"","pretty":false,"x":520,"y":280,"wires":[["rp_telemetry_template","rp_telemetry_debug"]]},{"id":"rp_telemetry_template","type":"ui-template","z":"rp_tab","group":"rp_ui_group","page":"","ui":"","name":"Live Sensor and Actuator Display","order":2,"width":"12","height":"8","head":"","format":"<template>\n  <div style=\"padding:12px\">\n    <h2>Live System Information</h2>\n    <div v-if=\"msg && msg.payload && msg.payload.phase\">\n      <p><b>Mode:</b> {{ msg.payload.mode }}</p>\n      <p><b>Current phase:</b> {{ msg.payload.phase }} — Day {{ msg.payload.day }} of {{ msg.payload.phaseDuration }}</p>\n\n      <h3>Soil Moisture</h3>\n      <div v-for=\"(value,i) in (msg.payload.soilMoisture || [])\" :key=\"'soil'+i\" style=\"margin:10px 0\">\n        <b>Zone {{ i+1 }}:</b> {{ value === null ? 'Sensor fault' : Number(value).toFixed(1)+'%' }}\n        <div style=\"height:12px;background:#e5e7eb;border-radius:8px;overflow:hidden\">\n          <div :style=\"{width:(value===null?0:Math.max(0,Math.min(100,Number(value))))+'%',height:'12px',background:'#287a46'}\"></div>\n        </div>\n      </div>\n\n      <h3>Water Distance from Sensor</h3>\n      <p v-for=\"(value,i) in (msg.payload.waterDistanceCm || [])\" :key=\"'water'+i\">\n        Zone {{ i+1 }}: {{ value === null ? 'Sensor fault' : Number(value).toFixed(1)+' cm' }}\n      </p>\n\n      <h3>Valve States</h3>\n      <p v-for=\"(value,i) in (msg.payload.valves || [])\" :key=\"'valve'+i\">\n        Zone {{ i+1 }}: <b>{{ value ? 'OPEN' : 'CLOSED' }}</b>\n      </p>\n\n      <p><b>Drainage relay:</b> {{ msg.payload.drainRelay ? 'ON' : 'OFF' }}</p>\n      <p><b>Drainage servo:</b> {{ msg.payload.drainServoOpen ? 'OPEN' : 'CLOSED' }}</p>\n      <p><b>MQTT:</b> {{ msg.payload.mqttConnected ? 'Connected' : 'Disconnected' }}</p>\n      <p><b>Soil sensor faults:</b> {{ (msg.payload.soilSensorFault || []).map((v,i)=>v?'Zone '+(i+1):'').filter(Boolean).join(', ') || 'None reported' }}</p>\n      <p><b>Water sensor faults:</b> {{ (msg.payload.waterSensorFault || []).map((v,i)=>v?'Zone '+(i+1):'').filter(Boolean).join(', ') || 'None reported' }}</p>\n    </div>\n    <p v-else>Waiting for telemetry from ESP32...</p>\n  </div>\n</template>","storeOutMessages":false,"resendOnRefresh":false,"templateScope":"local","className":"","x":800,"y":280,"wires":[[]]},{"id":"rp_telemetry_debug","type":"debug","z":"rp_tab","name":"Telemetry Debug","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","x":770,"y":360,"wires":[]},{"id":"rp_status_mqtt","type":"mqtt in","z":"rp_tab","name":"ESP32 Status","topic":"ricepaddy/status","qos":"1","datatype":"auto","broker":"rp_broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":260,"y":440,"wires":[["rp_status_json"]]},{"id":"rp_status_json","type":"json","z":"rp_tab","name":"Parse status JSON","property":"payload","action":"","pretty":false,"x":500,"y":440,"wires":[["rp_status_debug"]]},{"id":"rp_status_debug","type":"debug","z":"rp_tab","name":"ESP32 Status Debug","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","x":760,"y":440,"wires":[]},{"id":"rp_ui_group","type":"ui-group","name":"Irrigation Control and Telemetry","page":"rp_ui_page","width":"12","height":"12","order":1,"showTitle":true,"className":"","visible":true,"disabled":false,"groupType":"default"},{"id":"rp_broker","type":"mqtt-broker","name":"HiveMQ Cloud","broker":"8b2cddcc56554040b7ac19f53f364ddb.s1.eu.hivemq.cloud","port":"8883","tls":"rp_tls","clientid":"NodeRED-RicePaddy","autoConnect":true,"usetls":true,"protocolVersion":"4","keepalive":"60","cleansession":true,"autoUnsubscribe":true,"birthTopic":"","birthQos":"0","birthPayload":"","birthMsg":{},"closeTopic":"","closeQos":"0","closePayload":"","closeMsg":{},"willTopic":"","willQos":"0","willPayload":"","willMsg":{},"userProps":"","sessionExpiry":""},{"id":"rp_ui_page","type":"ui-page","name":"Irrigation Monitoring","ui":"rp_ui_base","path":"/rice-paddy","icon":"dashboard","layout":"grid","theme":"rp_ui_theme","breakpoints":[{"name":"Default","px":"0","cols":"3"},{"name":"Tablet","px":"576","cols":"6"},{"name":"Desktop","px":"768","cols":"12"}],"order":1,"visible":true,"disabled":false},{"id":"rp_tls","type":"tls-config","name":"HiveMQ TLS","cert":"","key":"","ca":"","certname":"","keyname":"","caname":"","verifyservercert":true,"alpnprotocol":""},{"id":"rp_ui_base","type":"ui-base","name":"Rice Paddy Dashboard","path":"/dashboard","appIcon":"","includeClientData":true,"acceptsClientConfig":["ui-notification","ui-control"],"showPathInSidebar":false,"headerContent":"page","navigationStyle":"default","titleBarStyle":"default","showReconnectNotification":true,"notificationDisplayTime":5,"showDisconnectNotification":true,"allowInstall":false},{"id":"rp_ui_theme","type":"ui-theme","name":"Rice Paddy Theme","colors":{"surface":"#ffffff","primary":"#287a46","bgPage":"#f3f6f3","groupBg":"#ffffff","groupOutline":"#d5dfd7"},"sizes":{"density":"default","pagePadding":"12px","groupGap":"12px","groupBorderRadius":"8px","widgetGap":"12px"}},{"id":"e55fb08c7a0f810d","type":"global-config","env":[],"modules":{"@flowfuse/node-red-dashboard":"1.30.2"}}]
