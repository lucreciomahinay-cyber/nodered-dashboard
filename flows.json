    {
        "id": "paddy_mqtt_in",
        "type": "mqtt in",
        "z": "f6f2187d.f17ca8",
        "name": "MQTT Telemetry In",
        "topic": "paddy/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "inputs": 0,
        "x": 280,
        "y": 280,
        "wires": [
            [
                "parser_router"
            ]
        ]
    },
    {
        "id": "parser_router",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Extract Telemetry Fields",
        "func": "var p = msg.payload;\nreturn [\n    { payload: p },\n    { payload: p.soil_z1 },\n    { payload: p.water_z1 },\n    { payload: p.soil_z2 },\n    { payload: p.water_z2 },\n    { payload: p.v_z1a === 1 },\n    { payload: p.v_z1b === 1 },\n    { payload: p.v_z2a === 1 },\n    { payload: p.v_z2b === 1 },\n    { payload: p.d_z1 === 1 },\n    { payload: p.d_z2 === 1 }\n];",
        "outputs": 11,
        "x": 510,
        "y": 280,
        "wires": [
            [
                "ui2_custom_status_card"
            ],
            [
                "ui2_gauge_soil_z1"
            ],
            [
                "ui2_gauge_water_z1"
            ],
            [
                "ui2_gauge_soil_z2"
            ],
            [
                "ui2_gauge_water_z2"
            ],
            [
                "ui2_sw_v1a"
            ],
            [
                "ui2_sw_v1b"
            ],
            [
                "ui2_sw_v2a"
            ],
