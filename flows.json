    {
        "id": "process_sensor",
        "type": "function",
        "z": "tab_rice_paddy",
        "name": "Process Sensor Data",
        "func": "let d = msg.payload;\n\nif (!d) {\n    return null;\n}\n\nfunction value(v, digits = 1) {\n    if (v === undefined || v === null || isNaN(Number(v))) {\n        return 0;\n    }\n    return Number(Number(v).toFixed(digits));\n}\n\nlet soil = Array.isArray(d.soil) ? d.soil : [0,0,0,0,0,0];\nlet water = Array.isArray(d.water) ? d.water : [0,0,0,0,0,0];\nlet valves = Array.isArray(d.valves) ? d.valves : [false,false,false,false];\n\nlet output = [];\n\n// 1 Mode\noutput[0] = {payload: d.mode || \"UNKNOWN\"};\n\n// 2 Phase\noutput[1] = {payload: d.phase || 0};\n\n// 3 Soil 1\noutput[2] = {payload: value(soil[0],1)};\n\n// 4 Soil 2\noutput[3] = {payload: value(soil[1],1)};\n\n// 5 Soil 3\noutput[4] = {payload: value(soil[2],1)};\n\n// 6 Zone 1 Soil Average\noutput[5] = {payload: value(d.zone1Soil,1)};\n\n// 7 Water 1\noutput[6] = {payload: value(water[0],1)};\n\n// 8 Water 2\noutput[7] = {payload: value(water[1],1)};\n\n// 9 Water 3\noutput[8] = {payload: value(water[2],1)};\n\n// 10 Zone 1 Water Average\noutput[9] = {payload: value(d.zone1Water,1)};\n\n// 11 Soil 4\noutput[10] = {payload: value(soil[3],1)};\n\n// 12 Soil 5\noutput[11] = {payload: value(soil[4],1)};\n\n// 13 Soil 6\noutput[12] = {payload: value(soil[5],1)};\n\n// 14 Zone 2 Soil Average\noutput[13] = {payload: value(d.zone2Soil,1)};\n\n// 15 Water 4\noutput[14] = {payload: value(water[3],1)};\n\n// 16 Water 5\noutput[15] = {payload: value(water[4],1)};\n\n// 17 Water 6\noutput[16] = {payload: value(water[5],1)};\n\n// 18 Zone 2 Water Average\noutput[17] = {payload: value(d.zone2Water,1)};\n\n// 19 Valve 1\noutput[18] = {payload: Boolean(valves[0])};\n\n// 20 Valve 2\noutput[19] = {payload: Boolean(valves[1])};\n\n// 21 Valve 3\noutput[20] = {payload: Boolean(valves[2])};\n\n// 22 Valve 4\noutput[21] = {payload: Boolean(valves[3])};\n\n// 23 Emergency drain\noutput[22] = {payload: Boolean(d.drain)};\n\nreturn output;",
        "outputs": 23,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 100,
        "wires": [
            [
                "text_mode"
            ],
            [
                "text_phase"
            ],
            [
                "gauge_soil1"
            ],
            [
                "gauge_soil2"
            ],
