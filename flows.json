                "ui2_sw_dz2"
            ]
        ]
    },
    {
        "id": "ui2_custom_status_card",
        "type": "ui-template",
        "z": "f6f2187d.f17ca8",
        "group": "group2_status",
        "name": "HTML Status Display",
        "order": 1,
        "width": 12,
        "height": 2,
        "format": "<template>\n    <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 12px; background: #21262d; border-radius: 8px; border: 1px solid #30363d;\">\n        <div>\n            <span style=\"color: #8b949e; font-size: 11px; display: block; font-weight: bold;\">SYSTEM MODE</span>\n            <strong style=\"color: #58a6ff; font-size: 18px;\">{{ msg?.payload?.mode || 'OFFLINE' }}</strong>\n        </div>\n        <div style=\"text-align: right;\">\n            <span style=\"color: #8b949e; font-size: 11px; display: block; font-weight: bold; margin-bottom: 4px;\">GROWTH PHASE</span>\n            <span style=\"background: #238636; color: white; padding: 4px 10px; border-radius: 12px; font-weight: bold; font-size: 13px;\">\n                Phase {{ msg?.payload?.phase || '0' }}\n            </span>\n        </div>\n    </div>\n</template>",
        "storeOutMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 1000,
        "y": 80,
        "wires": [
            []
        ]
    },
