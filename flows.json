        "id": "mqtt_in_data",
        "type": "mqtt in",
        "z": "tab_rice_paddy",
        "name": "Rice Paddy Sensor Data",
        "topic": "ricepaddy/data",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_hivemq",
        "nl": false,
        "rap": true,
        "rh": 0,
